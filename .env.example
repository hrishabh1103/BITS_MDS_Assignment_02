# Environment Configuration for Vehicle Troubleshooting Assistant
# Copy this file to .env and adjust variables as needed

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=database/chroma_db
CHROMA_COLLECTION_NAME=vehicle_troubleshooting_kb

# LLM Configuration (Ollama local by default, or configurable API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# External API Provider (Optional fallback, e.g. OpenAI or Gemini-compatible)
# EXTERNAL_API_KEY=your_api_key_here
# EXTERNAL_API_BASE_URL=https://api.openai.com/v1
# EXTERNAL_MODEL_NAME=gpt-4o-mini

# Application Settings
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8501
